// Prisma schema — ATS Resume Builder
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled — used by the app
  directUrl = env("DIRECT_URL") // unpooled — used by migrations
}

// Subscription tiers shown on the pricing page.
// Everyone starts on FREE; billing is wired up later.
enum Plan {
  FREE
  STANDARD
  PRO
  AI
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id String @id @default(cuid())

  email String @unique
  // Never the password itself — only its argon2id hash.
  passwordHash String
  name         String?

  // Null until the user clicks the link in the verification email.
  emailVerified DateTime?

  plan Plan @default(FREE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes Resume[]
  tokens  Token[]
  sessions Session[]
}

model Resume {
  id     String @id @default(cuid())
  userId String

  name       String @default("Untitled Resume")
  templateId String

  // The whole CV document and its style settings, stored as JSON.
  // Keeps the existing builder data shape without a migration per field.
  cvData        Json
  styleSettings Json
  pdfName       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One-time tokens for email verification and password reset.
model Token {
  id     String @id @default(cuid())
  userId String

  type TokenType

  // Hashed for the same reason passwords are: if the database leaks,
  // the raw tokens in it must not be usable to take over accounts.
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}
// Attempt counters for login, signup and the two endpoints that send mail.
// In the database rather than in memory because every serverless instance has
// its own memory and is recycled constantly - an in-process counter would let
// an attacker reset the limit just by being spread across instances.
model RateLimit {
  id String @id @default(cuid())

  // What is being limited ("login:email") and who is being limited.
  bucket String
  key    String

  count      Int
  windowEnds DateTime

  @@unique([bucket, key])
  @@index([windowEnds])
}

// Server-side sessions. Storing them lets us revoke a login instantly -
// something a self-contained JWT cannot do once it has been issued.
model Session {
  id     String @id @default(cuid())
  userId String

  // Only the hash of the cookie value. A leaked database must not hand
  // anyone a working session.
  tokenHash String @unique

  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}